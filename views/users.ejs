<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorer – SkillSwap</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/users.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="page">

        <div class="page-header">
            <h1>Explorer</h1>
            <p>Découvrez les compétences proposées par la communauté</p>
        </div>

        <% if (rows.length === 0) { %>
            <div class="empty-msg">Aucune compétence disponible pour le moment.</div>
        <% } else { %>
            <div class="skills-grid">
                <% rows.forEach(r => { %>
                    <div class="skill-card">
                        <div class="skill-card-header">
                            <div class="skill-card-avatar"><%= r.username[0].toUpperCase() %></div>
                            <div class="skill-card-user">
                                <a href="/users/<%= r.user_id %>"><%= r.username %></a>
                            </div>
                        </div>
                        <div class="skill-name"><%= r.skill_name %></div>
                        <form method="POST" action="/exchange">
                            <input type="hidden" name="giverId" value="<%= r.user_id %>">
                            <input type="hidden" name="skillId" value="<%= r.skill_id %>">
                            <button class="btn btn-success btn-sm">Demander · 1 crédit</button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } %>

    </main>
</body>
</html>
