<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion – SkillSwap</title>
    <link rel="icon" type="image/png" href="/images/Favicon SkillSwap.png">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-logo">
            <img src="/images/BLANC-RVB%20Logo%20SkillSwap.png" alt="SkillSwap" class="auth-logo-img">
        </div>
        <div class="auth-card">
            <h1>Bon retour 👋</h1>
            <p class="subtitle">Connectez-vous à votre compte</p>
            <form method="POST" class="auth-form">
                <div class="field-group">
                    <label for="email">Adresse email</label>
                    <input id="email" name="email" type="email" placeholder="vous@exemple.com" required>
                </div>
                <div class="field-group">
                    <label for="password">Mot de passe</label>
                    <input id="password" name="password" type="password" placeholder="••••••••" required>
                </div>
                <button class="btn btn-primary">Se connecter</button>
            </form>
        </div>
        <div class="auth-footer">
            <span>Pas encore de compte ?</span>
            <a href="/register">Créer un compte</a>
        </div>
    </div>
</body>
</html>
