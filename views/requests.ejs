<head>
    <meta charset="UTF-8">
    <title>Notifications – SkillSwap</title>
    <link rel="stylesheet" href="/css/requests.css">
</head>

<div class="requests-container">
    <h1>Demandes reçues</h1>

    <% rows.forEach(row=> { %>
        <div class="request-card">
            <div class="request-info">
                <strong>
                    <%= row.username %>
                </strong>
                <span>Compétence : <%= row.skill_name %></span>
                <span>Crédits : <%= row.credits %></span>
            </div>

            <div class="request-actions">
                <form method="POST" action="/exchange/accept">
                    <input type="hidden" name="exchangeId" value="<%= row.id %>">
                    <button class="btn btn-accept">Accepter</button>
                </form>

                <form method="POST" action="/exchange/reject">
                    <input type="hidden" name="exchangeId" value="<%= row.id %>">
                    <button class="btn btn-reject">Refuser</button>
                </form>
            </div>
        </div>
        <% }) %>
            <a href="/profile" class="btn primary">Mon profil</a>
</div>