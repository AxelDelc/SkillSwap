<% if (flash) { %>
<div class="toast toast-<%= flash.type %>" id="toast">
    <span class="toast-icon"><%= flash.type === 'success' ? '✓' : '!' %></span>
    <span class="toast-message"><%= flash.message %></span>
    <button class="toast-close" onclick="this.parentElement.remove()">×</button>
</div>
<script>
    setTimeout(() => {
        const t = document.getElementById('toast');
        if (t) { t.classList.add('toast-hide'); setTimeout(() => t.remove(), 400); }
    }, 3500);
</script>
<% } %>
