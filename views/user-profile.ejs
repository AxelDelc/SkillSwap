<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.username %> – SkillSwap</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/user-profile.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="page">

        <div class="up-header">
            <div class="up-avatar"><%= user.username[0].toUpperCase() %></div>
            <div class="up-info">
                <h1><%= user.username %></h1>
                <div class="email"><%= user.email %></div>
            </div>
        </div>

        <div class="up-actions">
            <a href="/messages/<%= user.id %>" class="btn btn-primary">✉ Envoyer un message</a>
        </div>

        <div class="section">
            <div class="section-title">Compétences proposées</div>
            <% if (offers.length === 0) { %>
                <p class="empty-msg">Aucune compétence proposée</p>
            <% } else { %>
                <div class="tags-list">
                    <% offers.forEach(o => { %>
                        <span class="tag tag-offer"><%= o.name %></span>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <div class="section">
            <div class="section-title">Compétences recherchées</div>
            <% if (requests.length === 0) { %>
                <p class="empty-msg">Aucune compétence recherchée</p>
            <% } else { %>
                <div class="tags-list">
                    <% requests.forEach(r => { %>
                        <span class="tag tag-request"><%= r.name %></span>
                    <% }) %>
                </div>
            <% } %>
        </div>

    </main>
</body>
</html>
