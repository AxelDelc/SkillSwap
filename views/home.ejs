<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkillSwap</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <main class="hero">
        <h1 class="hero-logo">SkillSwap</h1>
        <p class="hero-subtitle">
            Échange tes compétences,<br>construis ton réseau.
        </p>
        <div class="hero-actions">
            <% if (!userId) { %>
                <a href="/login"    class="btn btn-primary btn-lg">Se connecter</a>
                <a href="/register" class="btn btn-secondary btn-lg">S'inscrire</a>
            <% } else { %>
                <a href="/profile" class="btn btn-primary btn-lg">Mon profil</a>
                <a href="/users"   class="btn btn-secondary btn-lg">Explorer</a>
            <% } %>
        </div>
    </main>
</body>
</html>
